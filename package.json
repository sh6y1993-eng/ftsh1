{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node tests/verify-all-8-tasks.mjs",
    "test:recovery": "npx tsx tests/verify-database-recovery.mjs",
    "test:security": "npx tsx tests/verify-security-remediation.mjs",
    "test:startup": "npx tsx tests/verify-startup-security.mjs",
    "test:all": "npx tsx tests/verify-database-recovery.mjs && npx tsx tests/verify-security-remediation.mjs && npx tsx tests/verify-startup-security.mjs",
    "ios:sync": "vite build && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jose": "^6.2.17",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mqtt": "^5.16.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
