# Server & Runtime Configuration
PORT="3000"
NODE_ENV="development"

# Cryptographic HMAC Secret for Session Tokens (authToken), Recovery Codes, and Realtime Signatures
FATTESHHA_AUTH_SECRET="fatteshha_replace_with_strong_production_hmac_secret"

# Admin Moderation Panel Secret (required for /?admin=moderation login; never expose via VITE_*)
FATTESHHA_ADMIN_SECRET="replace_with_strong_admin_moderation_secret"

# Production Backend Origin for Native iOS / External Frontend Builds (leave empty "" in unified/preview mode to use relative /api/* and /ws; never use ais-dev-* or ais-pre-* URLs)
VITE_API_BASE_URL=""
VITE_BACKEND_URL=""

# Supabase Configuration (Client uses anon key; privileged server deletions/sync require service role key on backend only)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Google OAuth Feature Flag (disabled on native iOS by default; only set "true" on web with configured provider)
VITE_ENABLE_GOOGLE_OAUTH="false"

# AI Studio Platform Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
